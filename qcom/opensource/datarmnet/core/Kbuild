# uke: symbols from the cluster modules listed before this one in
# TARGET_KERNEL_EXT_MODULES. Upstream wires none of these, so modpost
# reports them undefined. Relative paths computed from $(src).
KBUILD_EXTRA_SYMBOLS += $(src)/../../datarmnet-ext/mem/Module.symvers
KBUILD_EXTRA_SYMBOLS += $(src)/../../dataipa/drivers/platform/msm/Module.symvers
ifneq (, $(filter y, $(CONFIG_ARCH_PINEAPPLE) $(CONFIG_ARCH_BLAIR) $(CONFIG_ARCH_MONACO) $(CONFIG_ARCH_PITTI)))
ccflags-y	+= -DRMNET_LA_PLATFORM
endif

ccflags-y += \
	-I$(srctree)/$(src)/../../dataipa/drivers/platform/msm/include \
	-I$(srctree)/$(src)/../../dataipa/drivers/platform/msm/include/uapi \
	-I$(srctree)/$(src)/../../datarmnet-ext/mem

obj-m += rmnet_core.o

#core sources
rmnet_core-y := \
	rmnet_config.o \
	rmnet_handlers.o \
	rmnet_descriptor.o \
	rmnet_genl.o \
	rmnet_map_command.o \
	rmnet_map_data.o \
	rmnet_module.o \
	rmnet_vnd.o

rmnet_core-y += \
	rmnet_ll.o \
	rmnet_ll_ipa.o

#DFC sources
rmnet_core-y += \
	qmi_rmnet.o \
	wda_qmi.o \
	dfc_qmi.o \
	dfc_qmap.o \
	rmnet_qmap.o \
	rmnet_ll_qmap.o

ifneq (, $(filter y, $(CONFIG_ARCH_PINEAPPLE) $(CONFIG_ARCH_BLAIR) $(CONFIG_ARCH_PITTI)))
obj-m += rmnet_ctl.o
rmnet_ctl-y := \
	rmnet_ctl_client.o \
	rmnet_ctl_ipa.o
endif
